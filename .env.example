# Frontend (Vite)
# Use full URL including scheme (http/https)
VITE_API_URL=https://your.domain.com/api
VITE_WS_URL=wss://your.domain.com/ws
VITE_SESSION_TIMEOUT_MIN=120
VITE_SESSION_WARNING_MIN=2
VITE_FORCE_HTTPS=false

# Backend
# Comma-separated list for multiple allowed origins
FRONTEND_URL=https://your.domain.com
SESSION_TTL_MIN=120
SESSION_WARNING_MIN=2
ANNOUNCED_IP=10.10.192.3
WEBRTC_TCP_ONLY=1
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100
PORT=5001

SSL_ENABLED=true
SSL_KEY_PATH=/path/to/key.pem
SSL_CERT_PATH=/path/to/cert.pem