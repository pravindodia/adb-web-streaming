# Docker Deployment Environment File
# Copy this to .env and customize for your deployment

# Frontend environment (passed to Vite at build time)
VITE_API_URL=http://localhost:5001
VITE_WS_URL=ws://localhost:5001
VITE_FORCE_HTTPS=false
VITE_SESSION_TIMEOUT_MIN=120
VITE_SESSION_WARNING_MIN=2

# Backend environment (runtime)
PORT=5001
FRONTEND_URL=http://localhost:5001
NODE_ENV=production
ANNOUNCED_IP=127.0.0.1
WEBRTC_TCP_ONLY=1
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100
SESSION_TTL_MIN=120
SESSION_WARNING_MIN=2
